#!/bin/sh /etc/rc.common
# Modified from luci-app-vsol-ddm (Apache-2.0, https://github.com/AliLostInTheDark/luci-app-vsol-ddm)
# for HSGQ / ODI DFP-34X GPON SFP sticks. See NOTICE for the list of changes.

USE_PROCD=1
START=95
STOP=10

PROG="/usr/libexec/rpcd/hsgq_ddm"

start_service() {
	local enabled
	config_load hsgq_ddm
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command "$PROG" "daemon"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "hsgq_ddm"
}
